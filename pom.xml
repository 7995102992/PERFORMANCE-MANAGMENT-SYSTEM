    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <mapstruct.version>1.6.2</mapstruct.version>
    </properties>

    <!-- Maven modules -->
    <modules>
        <module>pms-app</module>
        <module>pms-common</module>
        <module>pms-db</module>
        <module>pms-security</module>
        <module>pms-integration</module>
        <module>pms-messaging</module>
