{
  "info": {
    "name": "SRM — Service Request Management (Full API)",
    "description": "Complete API test collection for SRM backend.\n\nSetup:\n1. Start the SRM backend: `uvicorn src.main:app --reload`\n2. Ensure MongoDB and RabbitMQ are accessible\n3. Set `base_url` and `auth_token` collection variables\n4. For stub mode (no IAM), set `dev_session` header in pre-request scripts",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "api_prefix", "value": "/api/v1/service-requests" },
    { "key": "auth_token", "value": "", "description": "Session access token from IAM login" },
    { "key": "internal_token", "value": "dev-internal-token" },
    { "key": "dev_session", "value": "{\"id\":\"user_001\",\"organisation_id\":\"org_001\",\"email\":\"admin@test.com\",\"display_name\":\"Admin\",\"is_super_admin\":true,\"permissions\":[\"service_request_management:*\"],\"roles\":[\"super_admin\"]}", "description": "JSON session for X-SRM-Dev-Session (stub mode only)" },
    { "key": "category_id", "value": "" },
    { "key": "request_type_id", "value": "" },
    { "key": "workflow_id", "value": "" },
    { "key": "service_request_id", "value": "" },
    { "key": "comment_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{auth_token}}" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// In stub mode (IAM_BASE_URL empty), attach X-SRM-Dev-Session header",
          "const devSession = pm.collectionVariables.get('dev_session');",
          "if (devSession) {",
          "  pm.request.headers.add({ key: 'X-SRM-Dev-Session', value: devSession });",
          "}"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /healthz",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/healthz" } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 ok', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('ok'); });"], "type": "text/javascript" } }]
        },
        {
          "name": "GET /readyz",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/readyz" } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 + mongo + rabbitmq', () => { pm.response.to.have.status(200); const b = pm.response.json(); pm.expect(b).to.have.property('mongo'); pm.expect(b).to.have.property('rabbitmq'); });"], "type": "text/javascript" } }]
        }
      ]
    },
    {
