ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS — JSON list
CORS_ORIGINS=["http://localhost:3000"]

API_PREFIX=/api/v1/service-requests

# MongoDB
MONGO_DB_HOST=
MONGO_DB_PORT=27017
MONGO_DB_USER=
MONGO_DB_PASSWORD=
MONGO_DB_NAME=sentrifugo_srm

# Valkey
VALKEY_HOST=
VALKEY_PORT=6379
VALKEY_USER=
VALKEY_PASSWORD=
VALKEY_DB=0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=srm.events

# IAM (leave empty for stub mode)
IAM_BASE_URL=
IAM_SERVICE_TOKEN=

# Logging service
LOGGING_BASE_URL=
LOGGING_SERVICE_TOKEN=

# Internal job auth
INTERNAL_TOKEN=

# SLA tick — the loop that detects breaches and applies an SLA rule's violation
# actions. Every value below has a code default, so leaving them unset is a
# decision too, not a no-op.
#
#   SLA_TICK_INTERVAL_SECONDS  — seconds between ticks. Defaults to 60, so the
#                                loop starts on boot whether or not this is set.
#                                0 disables it and leaves /_internal/jobs/sla-tick
#                                for an external cron. Set 0 when first deploying
#                                against a database that has never been ticked,
#                                then enable once you have looked at what landed
#                                in the sla_deadlines collection.
#
#   SLA_ENFORCE_FROM           — discard any deadline that fell due before this
#                                instant: no email, no priority bump, no
#                                reassignment. Empty (the default) enforces
#                                everything, including a backlog of deadlines
#                                years past. Set it to deploy time when switching
#                                the ticker on against existing data — every
#                                ticket predates the tick ever running, so
#                                rebuild-sla-cursor would otherwise make the
#                                whole backlog due at once and mail a breach
#                                notice for each. ISO 8601; no timezone means UTC.
#
#   SLA_AUTO_ESCALATE_ENABLED  — the workflow's own escalation timer
#                                (Escalation Rules on the Workflow page), which
#                                hands a ticket to another person after N
#                                minutes. Off by default: turning it on starts
#                                moving tickets between people on a timer for
#                                every workflow that already has those rules
#                                switched on. Audit which those are first.
SLA_TICK_INTERVAL_SECONDS=60
SLA_ENFORCE_FROM=
SLA_AUTO_ESCALATE_ENABLED=false

# Frontend URL (for building email links in notifications)
FRONTEND_URL=http://localhost:3000

# Roster intimation on request raise.
#   ROSTER_INTIMATION_ENABLED          — kill switch. true (default) = every
#                                        executor on the category's roster,
#                                        primary and secondary alike, gets an
#                                        intimation email when a ticket is
#                                        raised. Nobody outside the roster is
#                                        mailed. false = feature off.
# (DEPT_INTIMATION_ENABLED / DEPT_INTIMATION_RECIPIENT_CAP are gone — they
#  mailed whole departments. Any leftover copies in OpenBao are ignored.)
ROSTER_INTIMATION_ENABLED=true

# Storage backend.
#   STORAGE_BACKEND=local  → write attachments to STORAGE_LOCAL_DIR (default).
#   STORAGE_BACKEND=s3     → upload to DigitalOcean Spaces, return presigned
#                            URLs on download. Requires DO_SPACES_* below.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./.storage

# DigitalOcean Spaces — only required when STORAGE_BACKEND=s3.
# Can reuse the same bucket as Sentrifugo-IAM-Admin-BE: SRM scopes its
# uploads under DO_SPACES_FOLDER inside the bucket so the two don't collide.
DO_SPACES_ACCESS_KEY=
DO_SPACES_SECRET_KEY=
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=us-east-1
DO_SPACES_BUCKET=
DO_SPACES_FOLDER=service-request-attachments
DO_SPACES_PRESIGN_TTL=300
