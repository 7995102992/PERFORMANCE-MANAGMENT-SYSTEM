ENVIRONMENT=development

# List of allowed origins for CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
DATABASE_TYPE=nosql

# Database configuration (set the URLs for the databases you want to use)
POSTGRES_URL=postgresql+asyncpg://postgres:password@localhost:5432/fastapi_db
MONGODB_URL=mongodb://localhost:27017/fastapi_db

# Neo4j configuration (graph projection — Mongo stays the system of record)
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j
NEO4J_DATABASE=neo4j

# Valkey configuration
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_USER=
VALKEY_PASSWORD=
VALKEY_DB=0

# RabbitMQ configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# JWT Authentication config
JWT_SECRET_KEY=super-secret-key-change-in-production
JWT_EXP_MINUTES=60

# DigitalOcean Spaces (S3-compatible object storage)
DO_SPACES_ACCESS_KEY=
DO_SPACES_SECRET_KEY=
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACES_BUCKET=
DO_SPACES_REGION=sgp1

# Frontend URLs
FRONTEND_URL=http://localhost:5173/admin     # admin portal (super/org admins)
USER_FRONTEND_URL=http://localhost:5174      # user portal (everyone else)

# Payslip Admin Emails (comma-separated)
PAYSLIP_ADMIN_EMAILS=padma.lakshmi@zenithdigital.com
