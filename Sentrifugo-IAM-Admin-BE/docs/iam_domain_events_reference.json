{
  "_description": "IAM Admin BE — Domain Events Reference. Use this to consume events in Leave Management or other downstream services.",
  "_exchange_info": {
    "domain_events": "TOPIC exchange for cross-service domain events",
    "audit_events": "TOPIC exchange for audit/logging events",
    "email_events": "TOPIC exchange for email task dispatch"
  },

  "domain_events": {

    "employee.created": {
      "exchange": "domain_events",
      "routing_key": "employee.created",
      "source_file": "src/modules/organisation/employees/utils/tools.py",
      "description": "Fired when a new employee is onboarded (single or bulk upload)",
      "payload": {
        "correlation_id": "string — request trace ID",
        "user_id": "string — auth user ID",
        "employee_id": "string — employee record ID",
        "organisation_id": "string",
        "emp_code": "string — e.g. 'EMP-0001'",
        "work_email": "string",
        "name": "string — full name (first + last)",
        "first_name": "string",
        "last_name": "string",
        "l1_manager_id": "string | null — user ID of L1 manager",
        "l2_manager_id": "string | null — user ID of L2 manager",
        "designation_id": "string | null",
        "department_id": "string | null",
        "business_unit_id": "string | null",
        "employment_status": "string — e.g. 'active', 'probation'",
        "date_of_joining": "string | null — ISO date"
      }
    },

    "employee.updated": {
      "exchange": "domain_events",
      "routing_key": "employee.updated",
      "source_file": "src/modules/organisation/employees/utils/tools.py",
      "description": "Fired when employee details are modified",
      "payload": {
        "correlation_id": "string",
        "employee_id": "string",
        "organisation_id": "string",
        "emp_code": "string",
        "work_email": "string | null",
        "name": "string | null — full name",
        "l1_manager_id": "string | null",
        "l2_manager_id": "string | null",
        "designation_id": "string | null",
        "department_id": "string | null",
        "business_unit_id": "string | null",
        "employment_status": "string",
        "date_of_joining": "string | null — ISO date",
        "changed_fields": ["string — list of field names that changed"]
      }
    },

    "employee.deleted": {
      "exchange": "domain_events",
      "routing_key": "employee.deleted",
      "source_file": "src/modules/organisation/employees/utils/tools.py",
      "description": "Fired when an employee is soft-deleted",
      "payload": {
        "correlation_id": "string",
        "user_id": "string",
        "organisation_id": "string"
      }
    },

    "organisation.created": {
      "exchange": "domain_events",
      "routing_key": "organisation.created",
      "source_file": "src/modules/organisation/organisation/utils/tools.py, src/tenancy/service.py",
      "description": "Fired when a new organisation/tenant is created",
      "payload": {
        "correlation_id": "string",
        "organisation_id": "string",
        "legal_name": "string",
        "financial_year": "string",
        "currency": "string — e.g. 'USD', 'INR'",
        "timezone": "string — e.g. 'Asia/Kolkata'",
        "is_multiple_business_units": "boolean",
        "is_active": "boolean",
        "enabled_modules": [
          { "code": "string — module code", "is_active": "boolean" }
        ],
        "setup_status": "string",
        "created_by": "string",
        "created_on": "string — ISO datetime",
        "modified_by": "string",
        "modified_on": "string — ISO datetime",
        "deleted_by": "string | null",
        "deleted_on": "string | null",
        "admin_email": "string — only from tenancy service"
      }
    },

    "organisation.updated": {
      "exchange": "domain_events",
      "routing_key": "organisation.updated",
      "source_file": "src/modules/organisation/organisation/utils/tools.py, src/tenancy/service.py",
      "description": "Fired when organisation details are modified",
      "payload": {
        "correlation_id": "string",
        "organisation_id": "string",
        "legal_name": "string",
        "financial_year": "string",
        "currency": "string",
        "timezone": "string",
        "is_multiple_business_units": "boolean",
        "is_active": "boolean",
        "enabled_modules": [
          { "code": "string", "is_active": "boolean" }
        ],
        "setup_status": "string",
        "created_by": "string",
        "created_on": "string — ISO datetime",
        "modified_by": "string",
        "modified_on": "string — ISO datetime",
        "deleted_by": "string | null",
        "deleted_on": "string | null",
        "changed_fields": ["string — list of field names that changed"]
      }
    },

    "organisation.deleted": {
      "exchange": "domain_events",
      "routing_key": "organisation.deleted",
      "source_file": "src/modules/organisation/organisation/utils/tools.py",
      "description": "Fired when an organisation is soft-deleted",
      "payload": {
        "correlation_id": "string",
        "organisation_id": "string",
        "legal_name": "string",
        "financial_year": "string",
        "currency": "string",
        "timezone": "string",
        "is_multiple_business_units": "boolean",
        "is_active": "boolean",
        "enabled_modules": [
          { "code": "string", "is_active": "boolean" }
        ],
        "setup_status": "string",
        "created_by": "string",
        "created_on": "string — ISO datetime",
        "modified_by": "string",
        "modified_on": "string — ISO datetime",
        "deleted_by": "string | null",
        "deleted_on": "string | null"
      }
    },

    "business_unit.created": {
      "exchange": "domain_events",
      "routing_key": "business_unit.created",
      "source_file": "src/modules/organisation/businessunit/utils/tools.py",
      "description": "Fired when a new business unit is created",
      "payload": {
        "correlation_id": "string",
        "business_unit_id": "string",
        "organisation_id": "string",
        "name": "string"
      }
    },

    "business_unit.deleted": {
      "exchange": "domain_events",
      "routing_key": "business_unit.deleted",
      "source_file": "src/modules/organisation/businessunit/utils/tools.py",
      "description": "Fired when a business unit is deleted (single or bulk)",
      "payload": {
        "correlation_id": "string",
        "business_unit_id": "string"
      }
    },

    "department.created": {
      "exchange": "domain_events",
      "routing_key": "department.created",
      "source_file": "src/modules/organisation/department/utils/tools.py",
      "description": "Fired when a new department is created",
      "payload": {
        "correlation_id": "string",
        "department_id": "string",
        "organisation_id": "string",
        "name": "string"
      }
    },

    "department.deleted": {
      "exchange": "domain_events",
      "routing_key": "department.deleted",
      "source_file": "src/modules/organisation/department/utils/tools.py",
      "description": "Fired when a department is deleted",
      "payload": {
        "correlation_id": "string",
        "department_id": "string"
      }
    },

    "designation.created": {
      "exchange": "domain_events",
      "routing_key": "designation.created",
      "source_file": "src/modules/organisation/designation/utils/tools.py",
      "description": "Fired when a new designation is created",
      "payload": {
        "correlation_id": "string",
        "designation_id": "string",
        "organisation_id": "string",
        "name": "string"
      }
    },

    "designation.deleted": {
      "exchange": "domain_events",
      "routing_key": "designation.deleted",
      "source_file": "src/modules/organisation/designation/utils/tools.py",
      "description": "Fired when a designation is deleted",
      "payload": {
        "correlation_id": "string",
        "designation_id": "string"
      }
    },

    "policy.created": {
      "exchange": "domain_events",
      "routing_key": "policy.created",
      "source_file": "src/policies/service.py",
      "description": "Fired when a new policy/role is created",
      "payload": {
        "correlation_id": "string",
        "policy_id": "string",
        "name": "string",
        "is_role": "boolean"
      }
    },

    "policy.deleted": {
      "exchange": "domain_events",
      "routing_key": "policy.deleted",
      "source_file": "src/policies/service.py",
      "description": "Fired when a policy/role is deleted",
      "payload": {
        "correlation_id": "string",
        "policy_id": "string"
      }
    },

    "user.created": {
      "exchange": "domain_events",
      "routing_key": "user.created",
      "source_file": "src/users/service.py",
      "description": "Fired when a new user account is created",
      "payload": {
        "correlation_id": "string",
        "user_id": "string",
        "email": "string",
        "first_name": "string",
        "last_name": "string",
        "auth_method": "string — 'local' | 'azure_sso'",
        "status": "string",
        "created_on": "string | null — ISO datetime"
      }
    }
  },

  "email_events": {

    "_envelope_structure": {
      "task_type": "email.send",
      "event_id": "string — UUID",
      "event_type": "string — routing key",
      "correlation_id": "string",
      "idempotency_key": "string — UUID",
      "tenant_id": "string — organisation_id",
      "payload": "object — see individual events below",
      "published_at": "string — ISO datetime"
    },

    "email.activation": {
      "exchange": "email_events",
      "routing_key": "email.activation",
      "source_file": "src/auth/utils/email_events.py",
      "description": "Account activation email with link",
      "payload": {
        "to": "string — recipient email",
        "template_id": "activation_v1",
        "template_data": {
          "display_name": "string",
          "activation_link": "string — full URL with token",
          "reset_link": "string | null — optional password reset link",
          "expires_in_human": "string — pre-rendered validity window, e.g. '72 hours'; covers BOTH links. Print verbatim; empty means omit the expiry sentence",
          "expires_in_seconds": "int — same window, machine-readable"
        }
      }
    },

    "email.password_reset": {
      "exchange": "email_events",
      "routing_key": "email.password_reset",
      "source_file": "src/auth/utils/email_events.py",
      "description": "Password reset email with link",
      "payload": {
        "to": "string — recipient email",
        "template_id": "password_reset_v1",
        "template_data": {
          "display_name": "string",
          "reset_link": "string — full URL with token",
          "expires_in_human": "string — pre-rendered validity window, e.g. '30 minutes'",
          "expires_in_seconds": "int — same window, machine-readable"
        }
      }
    },

    "email.email_change": {
      "exchange": "email_events",
      "routing_key": "email.email_change",
      "source_file": "src/auth/utils/email_events.py",
      "description": "Email change confirmation with link",
      "payload": {
        "to": "string — new email address",
        "template_id": "email_change_v1",
        "template_data": {
          "display_name": "string",
          "confirmation_link": "string — full URL with token",
          "expires_in_human": "string — pre-rendered validity window, e.g. '24 hours'",
          "expires_in_seconds": "int — same window, machine-readable"
        }
      }
    }
  },

  "audit_events": {
    "_description": "Published via outbox.publish_audit_log() to audit_events exchange. Consumed by the Logging Service.",
    "_standard_envelope": {
      "timestamp": "string — ISO datetime",
      "module": "string — e.g. 'iam', 'timesheet'",
      "actor_id": "string — user ID or 'system'",
      "action": "string — e.g. 'created', 'updated', 'deleted'",
      "resource": "string — e.g. 'employee:abc123', 'project:xyz'",
      "debug_level": "int — 1=EMPLOYEE, 2=MANAGER, 3=HR, 4=ADMIN",
      "metadata": "object | null — additional context"
    },
    "actions": [
      "created",
      "updated",
      "deleted",
      "bulk_deleted",
      "bulk_uploaded",
      "permissions_updated",
      "self_updated",
      "profile_photo_updated"
    ]
  },

  "_leave_management_notes": {
    "key_events_to_consume": [
      "employee.created — create local employee record for leave balance tracking",
      "employee.updated — sync manager changes (affects leave approval chain), department/designation changes (may affect leave policies)",
      "employee.deleted — deactivate employee leave records, cancel pending leaves",
      "organisation.created — initialize default leave policies for new tenant",
      "department.created — may need department-specific leave policies",
      "department.deleted — reassign employees' leave policies"
    ],
    "binding_pattern_examples": {
      "all_employee_events": "employee.*",
      "specific_event": "employee.created",
      "all_org_events": "organisation.*",
      "all_events": "#"
    },
    "consumer_setup": {
      "exchange": "domain_events",
      "exchange_type": "topic",
      "queue_name": "leave_management_queue",
      "durable": true,
      "prefetch_count": 10,
      "idempotency": "Use correlation_id + event_type as dedup key"
    }
  }
}
