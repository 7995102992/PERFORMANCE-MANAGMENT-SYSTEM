ENVIRONMENT=development

# List of allowed origins for CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# TimescaleDB configuration
TIMESCALEDB_DSN=postgresql://postgres:password@localhost:5432/sentrifugo

# API keys for audit log access (JSON: key -> debug level name)
VALID_API_KEYS={"my-api-key-1": "ADMIN", "my-api-key-2": "MANAGER"}
LOG_CACHE_TTL_SECONDS=60

# Redis/Valkey configuration
REDIS_URL=redis://localhost:6379/0

# RabbitMQ configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# JWT Authentication config
JWT_SECRET_KEY=super-secret-key-change-in-production
JWT_EXP_MINUTES=60
