# ── Runtime ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=

# List of allowed origins for CORS (JSON array)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# ── Database (MongoDB / Percona Server for MongoDB) ──────────────────────────
MONGO_DB_HOST=localhost
MONGO_DB_PORT=27017
MONGO_DB_USER=
MONGO_DB_PASSWORD=
MONGO_DB_NAME=sentrifugo_payroll

# ── Valkey (Redis-compatible) ────────────────────────────────────────────────
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_USER=
VALKEY_PASSWORD=
VALKEY_DB=0

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ── Sibling services ─────────────────────────────────────────────────────────
# Leave empty for local/stub mode (enables the X-Payroll-Dev-Session header).
IAM_BASE_URL=
IAM_SERVICE_TOKEN=
LOGGING_BASE_URL=
LOGGING_SERVICE_TOKEN=

# Shared secret for internal service-to-service / cron endpoints (X-Internal-Token)
INTERNAL_API_KEY=

# Frontend URL (for building email links)
FRONTEND_URL=http://localhost:3000

# ── DigitalOcean Spaces (S3-compatible object storage) ───────────────────────
DO_SPACES_ACCESS_KEY=
DO_SPACES_SECRET_KEY=
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACES_REGION=sgp1
DO_SPACES_BUCKET=
DO_SPACES_FOLDER=payroll-attachments
# Lifetime (seconds) of presigned download URLs returned by the upload APIs.
DO_SPACES_PRESIGN_TTL=300

# ── Encryption ───────────────────────────────────────────────────────────────
# Fernet key for sensitive fields at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Separate Fernet key for encrypting uploaded files (xlsx batches) in object
# storage. Generate the same way as ENCRYPTION_KEY; must differ from it.
FILE_ENCRYPTION_KEY=

# JWT signing secret (only needed if decoding IAM tokens locally)
JWT_SECRET_KEY=change-me-in-production
