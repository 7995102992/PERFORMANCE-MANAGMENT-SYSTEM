ENVIRONMENT=development

# List of allowed origins for CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# MongoDB configuration (individual fields — URL is built automatically)
MONGO_DB_HOST=localhost
MONGO_DB_PORT=27017
MONGO_DB_USER=
MONGO_DB_PASSWORD=
MONGO_DB_NAME=sentrifugo_lms

# Redis/Valkey configuration
VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379
VALKEY_USER=
VALKEY_PASSWORD=
VALKEY_DB=0

# RabbitMQ configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Frontend URL (for building email links in notifications)
# Origin of the main app, used for the deep links in notification emails.
FRONTEND_URL=http://localhost:5173
# testserv:
# FRONTEND_URL=https://testserv.sentrifugo.com
# prod:
# FRONTEND_URL=https://<prod-domain>

# Inbox(es) copied on every leave request submission (comma-separated).
# Sent independently of the approver chain, so HR still sees the request when
# no L1/L2 approver resolves. Leave blank to disable the HR copy.
LEAVE_HR_NOTIFY_EMAILS=hrd@sagarsoft.in


GEMINI_API_KEY= ""
GEMINI_MODEL= "gemini-2.5-flash"
ANTHROPIC_API_KEY= ""
ANTHROPIC_MODEL= "claude-sonnet-4-6"


DO_SPACES_ACCESS_KEY=
DO_SPACES_SECRET_KEY=
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACES_BUCKET=
DO_SPACES_REGION=sgp1

# Attendance ingest — shared secret the biometric collector service must send
# as the X-API-Key header on POST /attendance/ingest. Leave empty to disable
# the endpoint. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
ATTENDANCE_INGEST_API_KEY

# Organisation the pushed punches belong to, and the employee-code prefix used
# to match a device id (0534) to an employee (SIL-0534).
ATTENDANCE_ORG_ID
ATTENDANCE_EMP_CODE_PREFIX
