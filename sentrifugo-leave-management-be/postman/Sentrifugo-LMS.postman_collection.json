			"name": "Holiday Plans",
			"item": [
				{
					"name": "Create Holiday Plan",
					"request": {
						"method": "POST",
						"url": "{{base_url}}/holiday-plans",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"org_id\": \"{{org_id}}\",\n  \"name\": \"India Holidays 2025\",\n  \"country\": \"IN\",\n  \"year\": 2025,\n  \"business_unit_ids\": [],\n  \"department_ids\": []\n}"
						}
					},
					"event": [{"listen": "test", "script": {"exec": ["if (pm.response.code === 201) { pm.collectionVariables.set('holiday_plan_id', pm.response.json().id); }"]}}]
				},
				{
					"name": "List Holiday Plans",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/holiday-plans?org_id={{org_id}}",
