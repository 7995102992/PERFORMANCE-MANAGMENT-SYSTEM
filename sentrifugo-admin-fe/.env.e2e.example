# Playwright E2E config — copy to `.env.e2e` (git-ignored) and fill in.
#   cp .env.e2e.example .env.e2e
# Real shell/CI environment variables override anything set here.

# ── Required to run tests (not needed for `--list`) ──────────────────────────
E2E_PASSWORD=                 # org-admin / employee password
E2E_SUPERADMIN_PASSWORD=      # super-admin password

# ── Optional ─────────────────────────────────────────────────────────────────
# E2E_SUPERADMIN=            # super-admin login email (defaults to the seed admin)
# E2E_ORG_ADMIN=             # org-admin login email (default: orgadmin.zenith@yopmail.com)
# E2E_BASE_URL=http://localhost:5174/admin   # admin app origin + base path
# E2E_API_URL=http://localhost:8000          # IAM backend base URL

# Only needed for the org-admin activation spec (auto-skips if unset):
# E2E_VALKEY_HOST=localhost
# E2E_VALKEY_PORT=6379
# E2E_VALKEY_USERNAME=          # Redis ACL user, if your instance uses one
# E2E_VALKEY_PASSWORD=
# E2E_VALKEY_DB=0
# (or a single URL instead of the parts above)
# E2E_VALKEY_URL=redis://:<url-encoded-password>@localhost:6379/0
