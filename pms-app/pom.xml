<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
            http://maven.apache.org/POM/4.0.0
            https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Parent project -->
    <parent>
        <groupId>com.sentrifugo</groupId>
        <artifactId>sentrifugo-pms-service</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <properties>
        <project.version>1.0.0-SNAPSHOT</project.version>
    </properties>
    <artifactId>pms-app</artifactId>

    <dependencies>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>com.sentrifugo</groupId>
            <artifactId>pms-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.sentrifugo</groupId>
            <artifactId>pms-db</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.sentrifugo</groupId>
            <artifactId>pms-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.sentrifugo</groupId>
            <artifactId>pms-integration</artifactId>
            <version>${project.version}</version>

        </dependency>
        <dependency>
            <groupId>com.sentrifugo</groupId>
            <artifactId>pms-messaging</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <!-- Spring Boot plugin -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>
    </build>

</project>