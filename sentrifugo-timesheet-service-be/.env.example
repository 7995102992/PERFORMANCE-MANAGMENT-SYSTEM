ENVIRONMENT=development
LOG_LEVEL=info

# List of allowed origins for CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# API prefix
API_PREFIX=/api/v1/timesheets

# MongoDB (individual fields -> URL built automatically)
MONGO_DB_HOST=localhost
MONGO_DB_PORT=27017
MONGO_DB_USER=
MONGO_DB_PASSWORD=
MONGO_DB_NAME=sentrifugo_timesheet

# Valkey
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_DB=0
# VALKEY_USER=
# VALKEY_PASSWORD=

# RabbitMQ configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# IAM service base URL (empty string = stub mode for local dev)
IAM_BASE_URL=

# Frontend URL (for building email links in notifications)
FRONTEND_URL=http://localhost:3000
