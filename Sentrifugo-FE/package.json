{
  "name": "sentrifugo-fe-boilerplate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:testserv": "vite build --mode testserv",
    "upload:testserv": "tar -C dist -cf - . | ssh root@testserv.sentrifugo.com \"rm -rf ~/Sentrifugo-DevOps/frontend/main/* && tar -C ~/Sentrifugo-DevOps/frontend/main -xf -\"",
    "deploy:testserv": "npm run build:testserv && npm run upload:testserv",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:leave": "playwright test tests/leave",
    "test:leave:headed": "playwright test tests/leave --headed",
    "test:leave:lifecycle": "playwright test tests/leave/leave-request.lifecycle.spec.ts tests/leave/leave-request.ui.spec.ts",
    "test:leave:matrix": "playwright test tests/leave/leave-type.matrix.spec.ts tests/leave/leave-plan.matrix.spec.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/poppins": "^5.2.7",
    "@hookform/resolvers": "^5.2.2",
    "@reduxjs/toolkit": "^2.11.2",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-router": "^1.168.3",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "axios": "^1.13.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "country-data-list": "^1.6.3",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.13",
    "lucide-react": "^1.0.1",
    "pdfjs-dist": "^6.1.200",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-calendar": "^6.0.1",
    "react-circle-flags": "^0.0.29",
    "react-colorful": "^5.7.0",
    "react-date-picker": "^12.0.2",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.75.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "recharts": "^2.15.3",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.49.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
