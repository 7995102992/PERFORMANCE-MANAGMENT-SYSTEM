# Sentrifugo-FE (main app) — testserv build env
# Copy to `.env.testserv` (git-ignored) and fill in the secrets.
# Loaded only by `vite build --mode testserv` (npm run deploy:testserv).
# `npm run dev` ignores this file and uses .env (localhost).
VITE_IAM_BASE_URL=https://testserv.sentrifugo.com/api/iam
VITE_SRM_API_BASE_URL=https://testserv.sentrifugo.com/api/request
VITE_TIMESHEET_BASE_URL=https://testserv.sentrifugo.com/api/time-management/
VITE_LMS_BASE_URL=https://testserv.sentrifugo.com/api/lms
VITE_PAYROLL_BASE_URL=https://testserv.sentrifugo.com/api/payroll
VITE_EXPENSE_API_BASE_URL=https://testserv.sentrifugo.com/api/expense
VITE_GOOGLE_PLACES_API_KEY=
