ENVIRONMENT=development

# Database (PostgreSQL)
DB_TYPE=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/schedule_service_db

# Redis / Valkey
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Default Email Provider
DEFAULT_EMAIL_PROVIDER=brevo
DEFAULT_FALLBACK_CHAIN=ses,smtp

# Default Brevo credentials (fallback when no tenant-specific creds exist)
DEFAULT_BREVO_API_KEY=
DEFAULT_SENDER_EMAIL=noreply@example.com
DEFAULT_SENDER_NAME=Sentrifugo

# Credential source (env | vault)
CREDENTIAL_SOURCE=env

# ── "Raise a request in Sentrifugo" footer link (all email templates) ──
# All THREE values are environment-specific and MUST be set per environment.
# The category + subtype ObjectIds differ in every database, and both must
# point at a Category/Subtype that has an ACTIVE WORKFLOW (else the Raise
# Ticket form opens blank). The renderer builds the link at send time as:
#   {FRONTEND_BASE_URL}/service-request/my-requests/list?raise=1&category=<id>&subtype=<id>
#
# Local:
FRONTEND_BASE_URL=http://localhost:5173
SUPPORT_CATEGORY_ID=
SUPPORT_SUBTYPE_ID=
#
# Test server (example — use the IDs that exist in the test-server DB):
# FRONTEND_BASE_URL=https://testserv.sentrifugo.com
# SUPPORT_CATEGORY_ID=<test-server category ObjectId>
# SUPPORT_SUBTYPE_ID=<test-server subtype ObjectId>
#
# Production (example — use the IDs that exist in the production DB):
# FRONTEND_BASE_URL=https://<prod-domain>
# SUPPORT_CATEGORY_ID=<prod category ObjectId>
# SUPPORT_SUBTYPE_ID=<prod subtype ObjectId>

# Per-tenant credentials (optional, overrides defaults)
# TENANT__{tenant_id}__BREVO__API_KEY=xkeysib-...
# TENANT__{tenant_id}__SES__ACCESS_KEY=AKIA...
# TENANT__{tenant_id}__SES__SECRET_KEY=wJalr...
# TENANT__{tenant_id}__SES__REGION=ap-south-1
