ENVIRONMENT=development

# MS SQL Server (source database to crawl)
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_DB_NAME=sentrifugo
MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_TRUST_SERVER_CERTIFICATE=true

# Crawl scheduling
CRAWL_INTERVAL_HOURS=6
CRAWL_ON_STARTUP=true
CRAWL_QUERY=SELECT * FROM attendance_logs
CRAWL_BATCH_SIZE=500

# Target API (where crawled attendance data is pushed)
TARGET_API_URL=http://localhost:8000/api/v1/attendance/ingest
TARGET_API_KEY=
TARGET_API_TIMEOUT_SECONDS=30
